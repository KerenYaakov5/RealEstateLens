# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Leave empty to use the embedded PGlite database (stored in PGLITE_DATA_DIR).
# Production: Supabase connection string.
DATABASE_URL=
# PGLITE_DATA_DIR=./.pglite

# Defaults to ./data/madlan-sample.xlsx
# SEED_FILE_PATH=

# Sessions. JWT_SECRET is required in production (at least 32 random characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# SESSION_TTL_HOURS=168

# Rate limits
# RATE_LIMIT_PER_MINUTE=120
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
