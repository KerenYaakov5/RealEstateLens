# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Leave empty to use the embedded PGlite database (stored in PGLITE_DATA_DIR).
# Production: Supabase connection string.
DATABASE_URL=
# PGLITE_DATA_DIR=./.pglite

# Defaults to ./data/madlan-sample.xlsx
# SEED_FILE_PATH=

# Sessions. JWT_SECRET is required in production (at least 32 random characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# SESSION_TTL_HOURS=168

# Rate limits
# RATE_LIMIT_PER_MINUTE=120
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15

# Static reference data: minimum months between checks for a newer published file
# LOCALITIES_CHECK_MONTHS=6

# Built web client served by the API server (default: ../web/dist)
# WEB_DIST_PATH=

# Personal recommendations (LLM). Without API keys the automatic recommendation is shown.
# LLM_ENABLED=true            # kill switch: false = never call a model
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano
# LLM_TIMEOUT_MS=8000
# LLM_MAX_OUTPUT_TOKENS=300
# AI_DAILY_QUOTA=20           # personal recommendations per user per day (cache hits are free)
# LLM_DAILY_CALL_LIMIT=300    # model calls per day, all users together – hard cost ceiling
